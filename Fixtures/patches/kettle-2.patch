 }
 
+// AddBrewTasks adds several brews, one after another.
+func (s *BrewTaskService) AddBrewTasks(inputs []AddBrewTaskInput) ([]*repo.Brew, error) {
+	var brews []*repo.Brew
+	for _, input := range inputs {
+		brew, err := s.AddBrewTask(input)
+		if err != nil {
+			return brews, err
+		}
+		brews = append(brews, brew)
+	}
+	return brews, nil
+}
