+// EnqueueMany adds brews in order.
+// It takes the lock once.
+func (q *TaskQueue) EnqueueMany(ids []int64) {
+	if len(ids) == 0 {
+		return
+	}
+	q.mu.Lock()
+	defer q.mu.Unlock()
+	for _, id := range ids {
+		q.pending = append(q.pending, id)
+	}
+}
+
 // Next removes and returns the first brew, or false when empty.
 func (q *TaskQueue) Next() (int64, bool) {
 	q.mu.Lock()
