+// uniqueNames reports whether every name in a batch is distinct.
+func uniqueNames(names []string) bool {
+	seen := map[string]bool{}
+	for _, n := range names {
+		if seen[n] {
+			return false
+		}
+		seen[n] = true
+	}
+	return true
+}
